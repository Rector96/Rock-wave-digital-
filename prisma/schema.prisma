datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ServiceCategory {
  VEHICLE_RENEWAL
  NIN_SERVICES
  TIN_EXTRACTION
  CAC_REGISTRATION
  ELECTRICITY_UTILITY
  EDUCATION_PINS
}

enum OrderStatus {
  LOOKED_UP
  PAID
  DIGITAL_READY
  QUEUED_PRINT
  SEALED
  DISPATCHED
  DELIVERED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  fullName  String
  orders    HubOrder[]
  createdAt DateTime   @default(now())
}

model HubOrder {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  serviceType    ServiceCategory
  status         OrderStatus     @default(LOOKED_UP)
  paymentRef     String          @unique // Paystack transaction reference string
  rawGovCost     Decimal         @db.Decimal(10, 2)
  serviceMargin  Decimal         @db.Decimal(10, 2)
  deliveryFee    Decimal         @db.Decimal(10, 2) @default(0.00)
  totalCharged   Decimal         @db.Decimal(10, 2)
  isPhysical     Boolean         @default(false) // Tracks if physical fulfillment is needed
  metaPayload    Json            // Stores structural intake data dynamically (Plate nos, Names, Form data)
  trackingNotes  String?         // Text block for manual dispatch notes: "Rider: Tunde, 0802..."
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([paymentRef])
}
